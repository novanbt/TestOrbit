rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // 1. User Profiles & Subcollections (Attempts, Enrolled Tests, Scorecards)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Students can only read and write their own profile and attempts
      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // 2. Public Marketplace Catalog & Content
    // -------------------------------------------------------------------------
    // Anyone can read catalog content; authenticated users/admins can manage.
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mockTests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testSeries/{seriesId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testBundles/{bundleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /test_questions/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /creatorProfiles/{creatorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 3. Default Deny Fallback
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
