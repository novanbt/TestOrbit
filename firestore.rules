rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // 1. User Profiles & Subcollections (Attempts, Enrolled Tests, Scorecards)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Students can only read and write their own profile and attempts
      allow read, write: if isOwner(userId);

      // Matches all nested subcollections at any depth:
      // e.g., /users/{userId}/enrolledTests/{testId}
      //       /users/{userId}/attempts/{attemptId}
      //       /users/{userId}/activity/{activityId}
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // 2. Public Marketplace Catalog (Mock Tests, Test Series & Categories)
    // -------------------------------------------------------------------------
    // Anyone (including prospective students) can browse the catalog;
    // Authenticated administrators can modify or delete courses/tests.
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mockTests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testSeries/{seriesId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testBundles/{bundleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /test_series/{seriesId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Questions and Question Banks
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /test_questions/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Deleted Tests Tombstones (to prevent deleted mock tests from resurrecting)
    match /deleted_tests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // 3. Default Deny Fallback
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
