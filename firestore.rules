rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "testorbit@ellipse.com" ||
        request.auth.token.admin == true
      );
    }

    // -------------------------------------------------------------------------
    // 1. User Profiles & Subcollections (Attempts, Enrolled Tests, Orders)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Students can read/write their own profile; admins have management access
      allow read, write: if isOwner(userId) || isAdmin();

      match /{allPaths=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Collection Group Access for Administrative Aggregation & Analytics
    match /{path=**}/attempts/{attemptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /attempts/{attemptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. Public Marketplace Catalog & Educational Content
    // -------------------------------------------------------------------------
    // Anyone can read catalog content; authenticated users/admins can manage.
    match /tests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mockTests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testSeries/{seriesId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /testBundles/{bundleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /taxonomy/{taxonomyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /test_questions/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /creatorProfiles/{creatorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /adminNotifications/{notifId} {
      allow read, write: if isAdmin();
    }

    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /questionReports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. Default Deny Fallback
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
